# Terraform secrets pulled from 1Password via op run.
# These are op:// references, not secrets — resolving them requires a
# signed-in 1Password CLI (`op signin`).
#
# Usage:
#   make terraform-plan
#   make terraform-apply

TF_VAR_do_token=op://r4botie4jmy4iitgejz2uwabay/DigitalOcean-Debravinh-token/token

# Remote state backend (DO Spaces, shared sv-terraform-root bucket)
AWS_ACCESS_KEY_ID=op://r4botie4jmy4iitgejz2uwabay/DigitalOcean-Spaces-terraform/access-key-id
AWS_SECRET_ACCESS_KEY=op://r4botie4jmy4iitgejz2uwabay/DigitalOcean-Spaces-terraform/secret-access-key
